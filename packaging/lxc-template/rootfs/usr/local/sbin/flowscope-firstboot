#!/bin/sh
# Runs at boot, before FlowScope, in a container made from the FlowScope Proxmox template.
#   - every boot: makes SSH host keys if there are none (the template ships without, so no two containers share keys)
#   - first boot only: makes the "admin" password, hands it to FlowScope for its first start, and tells the person at the console where to find it
#   - first boot only: makes the ClickHouse user FlowScope stores its data with, with a password of its own, before the ClickHouse server starts
# Paths can be overridden with environment variables so the script can be tested outside a container.
set -eu

ETC="${FLOWSCOPE_ETC:-/etc/flowscope}"
RUNENV="${FLOWSCOPE_FIRSTBOOT_ENV:-/run/flowscope-firstboot.env}"
CREDS="${FLOWSCOPE_CREDS_FILE:-/root/flowscope-admin-password.txt}"
MOTD="${FLOWSCOPE_MOTD:-/etc/motd}"
OPT="${FLOWSCOPE_OPT:-/opt/flowscope}"
CH_HELPER="$OPT/packaging/linux/clickhouse-setup.sh"
MARKER="$ETC/.firstboot-done"
# The same script runs in the virtual machine appliance (packaging/vm), which marks itself with /etc/flowscope-vm.
if [ -f "${FLOWSCOPE_VM_MARK:-/etc/flowscope-vm}" ]; then KIND="virtual machine"; ADDR_HINT="hostname -I"; else KIND="container"; ADDR_HINT="hostname -I, or the container's Summary tab"; fi

if [ -z "${FLOWSCOPE_SKIP_SSH_KEYS:-}" ] && command -v ssh-keygen >/dev/null 2>&1; then
  ssh-keygen -A >/dev/null 2>&1 || true
fi

if [ -f "$MARKER" ]; then exit 0; fi

umask 077
if grep -Eq '^[[:space:]]*FLOWSCOPE_ADMIN_PASSWORD=.{12,}' "$ETC/flowscope.env" 2>/dev/null; then
  # someone already chose a password in the settings file; keep it
  note="The admin password is the one set in $ETC/flowscope.env."
else
  pw="$(head -c 64 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 20)"
  # /run is a RAM disk: the password is handed to FlowScope for this boot only and is not left in the settings file
  printf 'FLOWSCOPE_ADMIN_PASSWORD=%s\n' "$pw" > "$RUNENV"
  printf 'FlowScope administrator\n  user:      admin\n  password:  %s\n\nChange it after signing in, then delete this file.\n' "$pw" > "$CREDS"
  note="The admin password is in $CREDS   (cat $CREDS)"
fi

# ClickHouse (FlowScope's storage). The template ships the server but no user for FlowScope. Like the admin password, this one is made
# here, so containers cloned from one template never share it. It goes straight into the settings file; nothing else keeps a copy.
# The helper is plain sh and only needs these three small functions.
CH_DIR="${FLOWSCOPE_CH_ETC:-/etc/clickhouse-server}"
# A template built without ClickHouse (STORAGE_BACKEND=sqlite) has no such folder: nothing to set up, FlowScope uses its SQLite file.
if [ -d "$CH_DIR" ]; then storage_note="ClickHouse, inside this $KIND (flowscope-ctl doctor shows its state)"; else storage_note="SQLite (embedded, in /var/lib/flowscope)"; fi
say() { :; }; warn() { :; }; die() { echo "flowscope-firstboot: $*" >&2; exit 1; }
if [ -f "$CH_HELPER" ] && [ -d "$CH_DIR" ] && ! grep -Eq '^[[:space:]]*FLOWSCOPE_CLICKHOUSE_URL=.+' "$ETC/flowscope.env" 2>/dev/null; then
  # shellcheck source=/dev/null
  . "$CH_HELPER"
  if ch_binary_works; then
    ch_pw="$(ch_gen_password)"
    ch_write_user "$ch_pw"
    printf '\n# Storage: the ClickHouse server in this container, set up at first boot. Remove this line and restart to use another server.\nFLOWSCOPE_CLICKHOUSE_URL=%s\n' "$(ch_url "$ch_pw")" >> "$ETC/flowscope.env"
  else
    # This CPU cannot run ClickHouse (it would be killed with SIGILL and restart forever). No URL line: FlowScope uses SQLite. The marker
    # stops the ClickHouse service from starting at all (see clickhouse-server.service.d/flowscope.conf in the template).
    mkdir -p "$ETC"; touch "$ETC/.clickhouse-unsupported"
    storage_note="SQLite. This CPU cannot run ClickHouse (flowscope-ctl doctor explains)."
  fi
fi

umask 022
cat > "$MOTD" <<MSG

  FlowScope is installed in this $KIND.

    Web console:  https://<this $KIND's address>/      (address: $ADDR_HINT)
    Sign in as:   admin
    $note
    Exporters:    send NetFlow v5/v9 or IPFIX to this address, UDP 2055 or 4739
    Storage:      $storage_note
    Commands:     flowscope-ctl status | doctor | logs | update | reset-password admin
    Not loading?  run: flowscope-ctl doctor
    Settings:     $ETC/flowscope.env   (then: systemctl restart flowscope)

  To remove this message: rm /etc/motd

MSG

mkdir -p "$ETC"
touch "$MARKER"
