[Unit]
Description=FlowScope NetFlow/IPFIX collector
After=network-online.target clickhouse-server.service
Wants=network-online.target clickhouse-server.service
# clickhouse-server.service is the local ClickHouse the installers set up. On a machine without it these two words do nothing.

[Service]
Type=simple
User=flowscope
Group=flowscope
WorkingDirectory=/opt/flowscope
EnvironmentFile=-/etc/flowscope/flowscope.env
Environment=FLOWSCOPE_DATA_DIR=/var/lib/flowscope
ExecStart=/usr/bin/env node --disable-warning=ExperimentalWarning /opt/flowscope/dist/src/cli.js start
Restart=on-failure
RestartSec=5
StateDirectory=flowscope
ConfigurationDirectory=flowscope
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# AF_NETLINK is needed by Node.js itself: os.networkInterfaces() (libuv uv_interface_addresses) asks the kernel for the address list over a
# netlink socket, and without it the service exits at start with "uv_interface_addresses returned Unknown system error 97" (EAFNOSUPPORT).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
ReadWritePaths=/var/lib/flowscope

[Install]
WantedBy=multi-user.target
