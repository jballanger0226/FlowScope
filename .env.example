# Copy to .env next to docker-compose.yml:   cp .env.example .env
# Docker Compose reads it automatically.

# Password for the ClickHouse user "flowscope" (required). Letters and digits only, because it is placed inside a URL.
#   openssl rand -hex 16
CLICKHOUSE_PASSWORD=

# First start only: password for the FlowScope "admin" account (12+ characters). If empty, one is generated and printed in the log.
# FLOWSCOPE_ADMIN_PASSWORD=
