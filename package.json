{
  "name": "flowscope",
  "version": "0.1.0",
  "description": "FlowScope: NetFlow/IPFIX collector with per-hop stream tracing, SNMP link and QoS monitoring, reporting and an admin console.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.13" },
  "bin": { "flowscope": "dist/server/cli.js" },
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "node dist/server/main.js",
    "test": "node tools/build.mjs && node --test --test-concurrency=1 \"dist/test/*.test.js\"",
    "demo": "node tools/build.mjs && node dist/server/demo.js"
  },
  "dependencies": {
    "net-snmp": "^3.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.6.0"
  }
}
